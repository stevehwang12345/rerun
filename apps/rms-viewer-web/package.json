{
  "name": "@rms/viewer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "runtime:debug": "node ./scripts/build-runtime.mjs --debug",
    "runtime:release": "node ./scripts/build-runtime.mjs --release",
    "dev": "npm run dev:system",
    "dev:system": "npm run runtime:debug && node ./scripts/dev-system.mjs",
    "dev:mock": "npm run runtime:debug && vite --mode mock --host 127.0.0.1 --port 4173",
    "dev:host": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run runtime:release && npm run build:host",
    "build:host": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
